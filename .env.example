# Copy to .env and fill in. Everything without VITE_ stays server-side.

# ── AUTH0 ──
VITE_AUTH0_DOMAIN=                         # e.g. your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=                      # SPA application client id
AUTH0_DOMAIN=                              # same value, for the functions
AUTH0_CLIENT_ID=                           # same value, for the functions
AUTH0_ALLOWED_EMAILS=                      # optional: comma-separated allowlist

# ── STRIPE ──
STRIPE_CONFIG=                             # JSON {"secretKey":"","publishableKey":"","webhookSecret":""}
STRIPE_CUSTOMER_ID=                        # cus_… primary: subscription, card, portal
STRIPE_LEGACY_CUSTOMER_IDS=                # optional cus_…,cus_… older records, history only

# ── ANALYTICS: Simple Analytics (default) ──
SIMPLE_ANALYTICS_API_KEY=
ANALYTICS_HOSTNAME=                        # site hostname as in Simple Analytics (no sa. prefix)

# ── ANALYTICS: GA4 (only when the client uses Google Analytics) ──
GA4_PROPERTY_ID=                           # numeric property id, not the G- measurement id
GA4_CLIENT_EMAIL=                          # service account with Viewer on the property
GA4_PRIVATE_KEY=                           # its private key, newlines as \n
# Google search in the monthly report: add the service account above as a user on the site's
# Search Console property (any analytics provider). Optional; otherwise found from the domain.
GSC_SITE_URL=                              # sc-domain:example.com or https://example.com/

CLIENT_TIMEZONE=America/Denver             # calendar months for reports

# ── MONTHLY REPORTS ──
PSI_API_KEY=                               # PageSpeed Insights key for the monthly Lighthouse test (not needed with the GA4 service account)
LIGHTHOUSE_URL=                            # optional: defaults to https://<client domain>/

# ── SUPPORT EMAIL (Resend) ──
RESEND_API_KEY=
CONTACT_TO_EMAIL=                          # where support requests land
CONTACT_FROM_EMAIL=                        # verified Resend sender
SUPPORT_WEBHOOK_URL=                       # optional: forward requests to the Pipeline's receive-support-request
SUPPORT_WEBHOOK_TOKEN=                     # optional: defaults to PIPELINE_DASHBOARD_KEY

# ── FORM SUBMISSIONS INBOX ──
FORMS_INTAKE_SECRET=                       # write-only secret the website sends with each form (same value in the site's env)

# ── PIPELINE DASHBOARD (reports, Lighthouse checks, offline invoices, Content Kit, submissions) ──
PIPELINE_FUNCTIONS_URL=https://isyourwebsitegood.com/.netlify/functions
PIPELINE_DASHBOARD_KEY=                    # pkd_… — this client's key, from its Pipeline ClientDetail page
PIPELINE_CLIENT_ID=                        # this client's id in the Pipeline database

# ── ERROR MONITORING (optional) ──
# VITE_SENTRY_DSN turns Sentry on; the SENTRY_* build vars upload hidden source maps.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
